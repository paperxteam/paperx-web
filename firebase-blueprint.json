{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and subscription metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User UID" },
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Display name" },
        "email": { "type": "string", "description": "Email address" },
        "avatarUrl": { "type": "string", "description": "Avatar image URL" },
        "plan": { "type": "string", "description": "Subscription plan (Basic Plan, Plus Plan, Max Plan)" },
        "planExpiresAt": { "type": "string", "description": "Subscription expiration timestamp (ISO)" },
        "billingCycle": { "type": "string", "description": "Billing cycle (half-month, month, half-year, year)" },
        "subscriptionStatus": { "type": "string", "description": "Subscription status (active, expired, free, pending)" },
        "previousPlan": { "type": "string", "description": "Previous subscription plan before expiry" },
        "isPro": { "type": "boolean", "description": "Active paid subscriber flag" },
        "memberSince": { "type": "string", "description": "Member registration date" },
        "projectsUsed": { "type": "number", "description": "Projects used count" },
        "maxProjects": { "type": "number", "description": "Max allowed projects" },
        "status": { "type": "string", "description": "Account status (ACTIVE, DISABLED)" },
        "role": { "type": "string", "description": "User role (User, Admin, SuperAdmin)" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["uid", "email"]
    },
    "Order": {
      "title": "Order",
      "description": "Subscription orders and UTR payment submissions",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "uid": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "plan": { "type": "string" },
        "billingCycle": { "type": "string" },
        "durationDays": { "type": "number" },
        "planExpiresAt": { "type": "string" },
        "amount": { "type": "number" },
        "utr": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "verifiedAt": { "type": "string" }
      },
      "required": ["orderId", "uid", "utr", "status"]
    },
    "AppSetting": {
      "title": "AppSetting",
      "description": "Global app control settings, feature flags, banners, maintenance mode",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "bannerActive": { "type": "boolean" },
        "bannerText": { "type": "string" },
        "themePreset": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "Admin broadcasts, custom messages, and targeted user alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "recipient": { "type": "string" },
        "recipientEmail": { "type": "string" },
        "priority": { "type": "string" },
        "type": { "type": "string" },
        "createdAt": { "type": "number" },
        "sender": { "type": "string" },
        "isUrgentPopup": { "type": "boolean" }
      },
      "required": ["title", "body", "recipient"]
    },
    "StoredDocument": {
      "title": "StoredDocument",
      "description": "User processed and saved document with 5-year cloud retention and real-time synchronization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "date": { "type": "string" },
        "timestamp": { "type": "number" },
        "size": { "type": "string" },
        "type": { "type": "string" },
        "action": { "type": "string" },
        "dataUrl": { "type": "string" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "retentionYears": { "type": "number" }
      },
      "required": ["id", "name", "timestamp"]
    },
    "Receipt": {
      "title": "Receipt",
      "description": "Secure, immutable, backend-generated payment and refund receipts",
      "type": "object",
      "properties": {
        "receiptId": { "type": "string", "description": "Unique cryptographically secure receipt ID" },
        "invoiceId": { "type": "string", "description": "Unique cryptographically secure invoice ID" },
        "orderId": { "type": "string", "description": "Linked order reference ID" },
        "transactionId": { "type": "string", "description": "Unique payment/transaction ID" },
        "refundId": { "type": "string", "description": "Unique refund ID when applicable" },
        "uid": { "type": "string", "description": "Paying User UID" },
        "userName": { "type": "string", "description": "Masked or full customer name" },
        "userEmail": { "type": "string", "description": "Masked or full customer email" },
        "plan": { "type": "string", "description": "Selected plan name" },
        "billingCycle": { "type": "string", "description": "Selected billing cycle" },
        "durationDays": { "type": "number", "description": "Subscription duration in days" },
        "amount": { "type": "number", "description": "Payment or refund amount" },
        "currency": { "type": "string", "description": "Payment currency (e.g., INR)" },
        "paymentMethod": { "type": "string", "description": "Payment channel (e.g., UPI)" },
        "utr": { "type": "string", "description": "12-digit UPI reference number" },
        "paymentDate": { "type": "string", "description": "Exact transaction timestamp" },
        "refundDate": { "type": "string", "description": "Exact refund timestamp" },
        "subscriptionStart": { "type": "string", "description": "Active subscription start date" },
        "subscriptionExpiry": { "type": "string", "description": "Active subscription expiry date" },
        "status": { "type": "string", "description": "Verification status (VALID, REFUNDED, CANCELLED, INVALID)" },
        "verifiedAt": { "type": "string", "description": "Audit verification timestamp" },
        "createdAt": { "type": "string", "description": "Receipt creation timestamp" },
        "verificationId": { "type": "string", "description": "Secure cryptographic verification ID/Token" },
        "type": { "type": "string", "description": "Receipt type (PAYMENT_SUCCESSFUL, REFUND_SUCCESSFUL)" }
      },
      "required": ["receiptId", "uid", "amount", "status", "verificationId", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/documents/{docId}": {
      "schema": "StoredDocument",
      "description": "5-year archived documents for user with real-time synchronization"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "UTR payment submissions & subscription orders"
    },
    "/receipts/{receiptId}": {
      "schema": "Receipt",
      "description": "Backend-generated secure immutable receipts and refunds"
    },
    "/app_settings/{settingId}": {
      "schema": "AppSetting",
      "description": "Global app control settings & feature flags"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Admin broadcast messages, custom user notices & alerts"
    },
    "/audit_logs/{logId}": {
      "description": "Admin action audit logs"
    },
    "/documents/{docId}": {
      "description": "Document conversion records"
    }
  }
}
